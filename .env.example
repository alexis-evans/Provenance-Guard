GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=qwen/qwen3.8-27b
# Optional; supported by the model above. Omit for models without this option.
GROQ_REASONING_EFFORT=none
# Optional; default is instance/provenance_guard.sqlite3 in this repository.
# DATABASE_PATH=/absolute/path/to/provenance_guard.sqlite3
# Optional; certificate review is disabled until a secret of at least 32 characters is set.
# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# REVIEWER_TOKEN=your_generated_secret
# REVIEWER_NAME=Course reviewer
